<Window x:Class="PLCUnifiedSimulator.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PLCUnifiedSimulator.GUI"
        mc:Ignorable="d"
        Title="PLC Unified Simulator" Height="600" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Control Panel -->
        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Margin="5">
            <StackPanel Orientation="Horizontal" Margin="10">
                <TextBlock Text="PLC Type:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="PlcTypeComboBox" Width="150" Margin="0,0,20,0">
                    <ComboBoxItem Content="Mitsubishi MC" IsSelected="True"/>
                    <ComboBoxItem Content="Omron FINS"/>
                </ComboBox>

                <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="PortTextBox" Text="5000" Width="80" Margin="0,0,20,0"/>

                <Button x:Name="StartButton" Content="Start" Width="80" Margin="0,0,10,0" Click="StartButton_Click"/>
                <Button x:Name="StopButton" Content="Stop" Width="80" IsEnabled="False" Click="StopButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Device Values -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="0,0,2.5,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Device Values" FontWeight="Bold" Margin="10,5"/>
                    <DataGrid x:Name="DeviceDataGrid" Grid.Row="1" Margin="5" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device" Binding="{Binding DeviceType}" Width="*"/>
                            <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Log -->
            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="2.5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Log" FontWeight="Bold" Margin="10,5"/>
                    <TextBox x:Name="LogTextBox" Grid.Row="1" Margin="5" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Margin="5">
            <TextBlock x:Name="StatusTextBlock" Text="Ready" Margin="10,5"/>
        </Border>
    </Grid>
</Window>
