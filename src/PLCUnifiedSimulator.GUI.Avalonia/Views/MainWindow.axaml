<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PLCUnifiedSimulator.GUI.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:PLCUnifiedSimulator.GUI.Avalonia.Converters"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="PLCUnifiedSimulator.GUI.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PLC Unified Simulator - Modern Interface"
        WindowState="Normal"
        Width="1200"
        Height="800"
        CanResize="True"
        MinWidth="800"
        MinHeight="600"
        Background="{DynamicResource SurfaceBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- Modern Card Style -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Border.card:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}"/>
        </Style>

        <!-- Modern Button Styles -->
        <Style Selector="Button.filled">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="Button.filled:pointerover">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>

        <Style Selector="Button.tonal">
            <Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainerBrush}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="Button.outlined">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Modern Typography -->
        <Style Selector="TextBlock.display-large">
            <Setter Property="FontSize" Value="57"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
        </Style>

        <Style Selector="TextBlock.display-medium">
            <Setter Property="FontSize" Value="45"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
        </Style>

        <Style Selector="TextBlock.headline-large">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
        </Style>

        <Style Selector="TextBlock.headline-medium">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
        </Style>

        <Style Selector="TextBlock.title-large">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
        </Style>

        <Style Selector="TextBlock.title-medium">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
        </Style>

        <Style Selector="TextBlock.body-large">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
        </Style>

        <Style Selector="TextBlock.body-medium">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
        </Style>

        <Style Selector="TextBlock.label-large">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
        </Style>

        <!-- Status Indicators -->
        <Style Selector="TextBlock.status-success">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style Selector="TextBlock.status-error">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style Selector="TextBlock.status-warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- Navigation Rail -->
        <Style Selector="Border.nav-rail">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <!-- Navigation Item -->
        <Style Selector="Border.nav-item">
            <Setter Property="CornerRadius" Value="12,12,0,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
        </Style>

        <Style Selector="Border.nav-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}"/>
        </Style>

        <Style Selector="Border.nav-item.selected">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
        </Style>

        <!-- Input Fields -->
        <Style Selector="TextBox.modern">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style Selector="TextBox.modern:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- List Containers -->
        <Style Selector="ListBox.modern">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="ListBoxItem.modern">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style Selector="ListBoxItem.modern:selected">
            <Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainerBrush}"/>
        </Style>

        <Style Selector="ListBoxItem.modern:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}"/>
        </Style>

        <!-- Data Grid -->
        <Style Selector="DataGrid.modern">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>

        <Style Selector="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="DataGridRow:selected">
            <Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}"/>
        </Style>

        <Style Selector="DataGridRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}"/>
        </Style>

        <!-- Mobile Menu Button -->
        <Style Selector="Button.menu-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
        </Style>

        <Style Selector="Button.menu-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}"/>
        </Style>

        <!-- Mobile Navigation Overlay -->
        <Style Selector="Border.mobile-nav-overlay">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}"/>
            <Setter Property="Width" Value="280"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <!-- Window Control Buttons -->
        <Style Selector="Button.window-control">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        </Style>

        <Style Selector="Button.window-control:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}"/>
        </Style>

        <Style Selector="Button.window-control.close:pointerover">
            <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnErrorBrush}"/>
        </Style>
    </Window.Styles>

    <!-- Custom Title Bar -->
    <Grid RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Background="{DynamicResource SurfaceContainerBrush}" Height="48">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="8,0,0,0">
                <!-- Mobile Menu Button -->
                <Button Grid.Column="0" Classes="menu-button" Content="☰" FontSize="18" 
                       IsVisible="{Binding !IsVisible, ElementName=TabBar}" Name="MobileMenuButton"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="🏭" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="PLC Unified Simulator" Classes="title-large" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Draggable Area -->
                <Border Grid.Column="2" Background="Transparent" Name="TitleBarDragArea"/>
                
                <TextBlock Grid.Column="3" Text="{Binding StatusMessage}" Classes="body-medium" 
                          Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" 
                          Margin="0,0,16,0"/>
                
                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Classes="window-control" Content="&#xE921;" Name="MinimizeButton" 
                           ToolTip.Tip="最小化" Command="{Binding MinimizeWindowCommand}"/>
                    <Button Classes="window-control" Content="&#xE922;" Name="MaximizeButton" 
                           ToolTip.Tip="最大化" Command="{Binding MaximizeWindowCommand}"/>
                    <Button Classes="window-control close" Content="&#xE8BB;" Name="CloseButton" 
                           ToolTip.Tip="閉じる" Command="{Binding CloseWindowCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Bar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceContainerBrush}" 
                BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="0,0,0,1"
                IsVisible="{Binding Bounds.Width, ElementName=MainGrid, Converter={StaticResource ResponsiveNavVisibilityConverter}}"
                Name="TabBar">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Margin="16,0" Name="TabPanel">
                    <!-- Dashboard -->
                    <Border Classes="nav-item selected" Name="DashboardNav" PointerPressed="Tab_PointerPressed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="📊" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="ダッシュボード" Classes="label-large" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Simulators -->
                    <Border Classes="nav-item" Name="SimulatorsNav" PointerPressed="Tab_PointerPressed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⚙️" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="シミュレータ" Classes="label-large" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Test Data -->
                    <Border Classes="nav-item" Name="TestDataNav" PointerPressed="Tab_PointerPressed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="📝" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="テストデータ" Classes="label-large" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Settings -->
                    <Border Classes="nav-item" Name="SettingsNav" PointerPressed="Tab_PointerPressed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🔧" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="設定" Classes="label-large" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Logs -->
                    <Border Classes="nav-item" Name="LogsNav" PointerPressed="Tab_PointerPressed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="📋" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="ログ" Classes="label-large" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2" Name="MainGrid">
            <!-- Content Area -->
            <ScrollViewer Background="{DynamicResource SurfaceBrush}" Name="ContentArea">
                <TabControl SelectedIndex="{Binding SelectedTabIndex}" Margin="{Binding Bounds.Width, ElementName=ContentArea, Converter={StaticResource ResponsiveMarginConverter}}">
                    <!-- Dashboard Tab -->
                    <TabItem Header="📊 ダッシュボード" IsVisible="False">
                        <StackPanel>
                    <!-- Dashboard Cards - Responsive Layout -->
                    <ItemsControl Margin="0,0,0,24">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding Bounds.Width, ElementName=ContentArea, Converter={StaticResource ResponsiveUniformGridConverter}}" 
                                            HorizontalAlignment="Stretch"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        
                        <ItemsControl.Items>
                            <!-- Active Simulators Card -->
                            <Border Classes="card">
                                <StackPanel>
                                    <TextBlock Text="アクティブシミュレータ" Classes="title-medium" Margin="0,0,0,16"/>
                                    <TextBlock Text="{Binding RunningSimulators.Count}" Classes="display-medium" 
                                              Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="台実行中" Classes="body-medium" 
                                              Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- System Status Card -->
                            <Border Classes="card">
                                <StackPanel>
                                    <TextBlock Text="システム状態" Classes="title-medium" Margin="0,0,0,16"/>
                                    <TextBlock Text="✅" Classes="display-medium"/>
                                    <TextBlock Text="{Binding SystemStatus}" Classes="body-medium" 
                                              Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Total Connections Card -->
                            <Border Classes="card">
                                <StackPanel>
                                    <TextBlock Text="総接続数" Classes="title-medium" Margin="0,0,0,16"/>
                                    <TextBlock Text="{Binding TotalConnections}" Classes="display-medium" 
                                              Foreground="{DynamicResource TertiaryBrush}"/>
                                    <TextBlock Text="接続中" Classes="body-medium" 
                                              Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                                </StackPanel>
                            </Border>
                        </ItemsControl.Items>
                    </ItemsControl>

                    <!-- Quick Actions -->
                    <Border Classes="card" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="クイックアクション" Classes="title-large" Margin="0,0,0,20"/>
                            <Panel Name="QuickActionsPanel">
                                <StackPanel Name="HorizontalButtons" 
                                           Orientation="Horizontal" 
                                           Spacing="16"
                                           IsVisible="{Binding Bounds.Width, ElementName=ContentArea, Converter={StaticResource ResponsiveConverter}, ConverterParameter=600}">
                                    <Button Classes="filled" Content="全シミュレータ開始" Command="{Binding StartAllSimulatorsCommand}"/>
                                    <Button Classes="tonal" Content="全シミュレータ停止" Command="{Binding StopAllSimulatorsCommand}"/>
                                    <Button Classes="outlined" Content="テストデータ設定" Command="{Binding SetTestDataCommand}"/>
                                    <Button Classes="outlined" Content="ログクリア" Command="{Binding ClearLogsCommand}"/>
                                </StackPanel>
                                
                                <StackPanel Name="VerticalButtons" 
                                           Orientation="Vertical" 
                                           Spacing="12"
                                           IsVisible="{Binding !IsVisible, ElementName=HorizontalButtons}">
                                    <Button Classes="filled" Content="全シミュレータ開始" Command="{Binding StartAllSimulatorsCommand}" HorizontalAlignment="Stretch"/>
                                    <Button Classes="tonal" Content="全シミュレータ停止" Command="{Binding StopAllSimulatorsCommand}" HorizontalAlignment="Stretch"/>
                                    <Button Classes="outlined" Content="テストデータ設定" Command="{Binding SetTestDataCommand}" HorizontalAlignment="Stretch"/>
                                    <Button Classes="outlined" Content="ログクリア" Command="{Binding ClearLogsCommand}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Panel>
                        </StackPanel>
                    </Border>

                    <!-- Running Simulators -->
                    <Border Classes="card" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="実行中のシミュレータ" Classes="title-large" Margin="0,0,0,20"/>
                            
                            <ListBox ItemsSource="{Binding RunningSimulators}" Classes="modern">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="card" Margin="0,4">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <Border Grid.Column="0" Background="{DynamicResource SuccessContainerBrush}" 
                                                       CornerRadius="12" Width="24" Height="24" Margin="0,0,16,0">
                                                    <TextBlock Text="●" Classes="label-large" 
                                                              Foreground="{DynamicResource OnSuccessContainerBrush}" 
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Classes="title-medium"/>
                                                    <TextBlock Text="{Binding Protocol}" Classes="body-medium" 
                                                              Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                                                    <TextBlock Text="{Binding EndPoint}" Classes="body-medium" 
                                                              Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                                                </StackPanel>
                                                
                                                <TextBlock Grid.Column="2" Text="実行中" Classes="status-success" 
                                                          VerticalAlignment="Center" Margin="0,0,16,0"/>
                                                
                                                <Button Grid.Column="3" Classes="outlined" Content="停止" 
                                                       VerticalAlignment="Center"
                                                       Command="{Binding $parent[ListBox].DataContext.StopSelectedSimulatorCommand}"
                                                       CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            
                            <TextBlock IsVisible="{Binding !RunningSimulators.Count}" 
                                      Text="実行中のシミュレータはありません" 
                                      Classes="body-medium" 
                                      Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                      HorizontalAlignment="Center" 
                                      Margin="0,40"/>
                        </StackPanel>
                    </Border>

                    <!-- Available Simulators -->
                    <Border Classes="card" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="利用可能なシミュレータ" Classes="title-large" Margin="0,0,0,20"/>
                            
                            <ItemsControl ItemsSource="{Binding AvailableSeries}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding Bounds.Width, ElementName=ContentArea, Converter={StaticResource ResponsiveUniformGridConverter}}" 
                                                    HorizontalAlignment="Stretch"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="card" Margin="8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Classes="title-medium" Margin="0,0,0,8"/>
                                                <TextBlock Text="{Binding Description}" Classes="body-medium" 
                                                          Foreground="{DynamicResource OnSurfaceVariantBrush}" 
                                                          Margin="0,0,0,8"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                                                    <Border Background="{DynamicResource PrimaryContainerBrush}" 
                                                           CornerRadius="4" Padding="8,4">
                                                        <TextBlock Text="{Binding Protocol}" Classes="label-large" 
                                                                  Foreground="{DynamicResource OnPrimaryContainerBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <Button Classes="tonal" Content="開始" 
                                                       Command="{Binding $parent[ItemsControl].DataContext.StartSpecificSimulatorCommand}"
                                                       CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Device Values Monitoring -->
                    <Border Classes="card">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,20">
                                <TextBlock Grid.Column="0" Text="デバイス値モニタリング" Classes="title-large"/>
                                
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <CheckBox IsChecked="{Binding IsAutoRefreshEnabled}" 
                                             Content="自動更新" 
                                             Command="{Binding ToggleAutoRefreshCommand}"/>
                                    <TextBlock Text="間隔:" Classes="body-medium" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding AutoRefreshInterval}" 
                                            Width="60" 
                                            Classes="modern"
                                            Watermark="ms"/>
                                </StackPanel>
                                
                                <Button Grid.Column="2" Classes="outlined" Content="更新" 
                                       Command="{Binding RefreshDeviceValuesCommand}"/>
                            </Grid>
                            
                            <DataGrid ItemsSource="{Binding DeviceValues}" Classes="modern" 
                                     AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="デバイス" Binding="{Binding DeviceAddress}" Width="*"/>
                                    <DataGridTextColumn Header="値" Binding="{Binding Value}" Width="*"/>
                                    <DataGridTextColumn Header="タイプ" Binding="{Binding DataType}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Recent Logs Preview -->
                    <Border Classes="card">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                                <TextBlock Grid.Column="0" Text="最近のログ" Classes="title-large"/>
                                <Button Grid.Column="1" Classes="outlined" Content="全て表示" 
                                       Command="{Binding NavigateToTabCommand}" CommandParameter="Logs"/>
                            </Grid>
                            
                            <ListBox ItemsSource="{Binding RecentLogMessages}" Classes="modern" MaxHeight="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Classes="body-medium"
                                                  TextWrapping="Wrap" Margin="8,4"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                    </TabItem>

                    <!-- Logs Tab -->
                    <TabItem Header="📋 ログ" IsVisible="False">
                        <StackPanel>
                    <!-- Logs Header -->
                    <Border Classes="card" Margin="0,0,0,24">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,20">
                                <TextBlock Grid.Column="0" Text="ログ" Classes="title-large"/>
                                
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="フィルタ:" Classes="body-medium" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding LogFilterText}" 
                                            Width="150" 
                                            Classes="modern"
                                            Watermark="キーワードで検索"/>
                                </StackPanel>
                                
                                <Button Grid.Column="2" Classes="outlined" Content="クリア" 
                                       Command="{Binding ClearLogsCommand}" Margin="0,0,8,0"/>
                                
                                <Button Grid.Column="3" Classes="outlined" Content="エクスポート" 
                                       Command="{Binding ExportLogsCommand}"/>
                            </Grid>
                            
                            <!-- Log Statistics -->
                            <Grid ColumnDefinitions="*,*,*,*" Margin="0,0,0,20">
                                <Border Background="{DynamicResource SurfaceContainerHighBrush}" 
                                       CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LogMessages.Count}" Classes="title-large" 
                                                  Foreground="{DynamicResource PrimaryBrush}"/>
                                        <TextBlock Text="総ログ数" Classes="body-medium" 
                                                  Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                                    </StackPanel>
                                </Border>
                                
                                <Border Background="{DynamicResource SurfaceContainerHighBrush}" 
                                       CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ErrorLogCount}" Classes="title-large" 
                                                  Foreground="{DynamicResource ErrorBrush}"/>
                                        <TextBlock Text="エラー" Classes="body-medium" 
                                                  Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                                    </StackPanel>
                                </Border>
                                
                                <Border Background="{DynamicResource SurfaceContainerHighBrush}" 
                                       CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding WarningLogCount}" Classes="title-large" 
                                                  Foreground="{DynamicResource WarningBrush}"/>
                                        <TextBlock Text="警告" Classes="body-medium" 
                                                  Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                                    </StackPanel>
                                </Border>
                                
                                <Border Background="{DynamicResource SurfaceContainerHighBrush}" 
                                       CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="{Binding InfoLogCount}" Classes="title-large" 
                                                  Foreground="{DynamicResource InfoBrush}"/>
                                        <TextBlock Text="情報" Classes="body-medium" 
                                                  Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Logs List -->
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Text="ログメッセージ" Classes="title-large" Margin="0,0,0,20"/>
                            
                            <ListBox ItemsSource="{Binding FilteredLogMessages}" Classes="modern" 
                                    MaxHeight="600" SelectionMode="Multiple">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="card" Margin="0,4">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <!-- Log Level Indicator -->
                                                <Border Grid.Column="0" Width="4" Height="40" 
                                                       CornerRadius="2" Margin="0,0,16,0"
                                                       Background="{Binding LogLevel, Converter={StaticResource LogLevelToColorConverter}}"/>
                                                
                                                <!-- Log Content -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Timestamp, StringFormat='yyyy/MM/dd HH:mm:ss'}" 
                                                              Classes="body-medium" 
                                                              Foreground="{DynamicResource OnSurfaceVariantBrush}"/>
                                                    <TextBlock Text="{Binding Message}" Classes="body-large" 
                                                              TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                
                                                <!-- Log Level Badge -->
                                                <Border Grid.Column="2" Background="{Binding LogLevel, Converter={StaticResource LogLevelToColorConverter}}" 
                                                       CornerRadius="12" Padding="8,4" Margin="16,0,0,0">
                                                    <TextBlock Text="{Binding LogLevel}" Classes="label-large" 
                                                              Foreground="{Binding LogLevel, Converter={StaticResource LogLevelToForegroundConverter}}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            
                            <TextBlock IsVisible="{Binding !FilteredLogMessages.Count}"
                                      Text="ログメッセージはありません"
                                      Classes="body-medium"
                                      Foreground="{DynamicResource OnSurfaceVariantBrush}"
                                      HorizontalAlignment="Center"
                                      Margin="0,40"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                    </TabItem>
                </TabControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>