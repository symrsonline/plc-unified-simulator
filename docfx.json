{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "src",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "docker-compose.yml",
          "docker-compose.dev.yml",
          "filterConfig.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "PLC Unified Simulator",
      "_appTitle": "PLC Unified Simulator API Reference",
      "_appFooter": "© 2025 PLC Unified Simulator. Licensed under MIT.",
      "_enableSearch": true,
      "_enableNewTab": true,
      "pdf": false
    },
    "dest": "api-docs"
  }
}