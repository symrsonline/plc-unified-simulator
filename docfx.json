{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "src",
          "files": [
            "PLCUnifiedSimulator.Core/PLCUnifiedSimulator.Core.csproj",
            "PLCUnifiedSimulator.Console/PLCUnifiedSimulator.Console.csproj",
            "PLCUnifiedSimulator.Protocols.Mitsubishi/PLCUnifiedSimulator.Protocols.Mitsubishi.csproj",
            "PLCUnifiedSimulator.Protocols.Omron/PLCUnifiedSimulator.Protocols.Omron.csproj",
            "PLCUnifiedSimulator.Simulators/PLCUnifiedSimulator.Simulators.csproj"
          ]
        }
      ],
      "output": "api",
      "filter": "filterConfig.yml"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "api/**",
          "filterConfig.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "api-docs",
    "template": [
      "modern"
    ],
    "globalMetadata": {
      "_appName": "PLC Unified Simulator API Reference",
      "_appTitle": "PLC Unified Simulator API Reference",
      "_appFooter": "© 2025 PLC Unified Simulator. Licensed under MIT.",
      "_enableSearch": true,
      "_enableNewTab": true,
      "pdf": false
    }
  }
}